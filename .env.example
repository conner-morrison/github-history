# Copy to .env and fill in. These values replace every author/committer in
# history, and must match the account `gh auth status` reports or the
# force-push is refused.
#
#   GIT_AUTHOR_NAME  -> your GitHub login, or your profile's display name
#   GIT_AUTHOR_EMAIL -> a verified address on the account, or the noreply form
#                       <login>@users.noreply.github.com
GIT_AUTHOR_NAME="your-github-login"
GIT_AUTHOR_EMAIL="your-github-login@users.noreply.github.com"

# Optional - default to the author values above.
# GIT_COMMITTER_NAME="your-github-login"
# GIT_COMMITTER_EMAIL="your-github-login@users.noreply.github.com"
